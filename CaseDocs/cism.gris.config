[grid]
  dew = 4000.
  dns = 4000.
  ewn = 421
  global_bc = 1
  nsn = 721
  nx_block = 0
  ny_block = 0
  upn = 11

[GLAD climate]
  evolve_ice = 1
  zero_gcm_fluxes = .false.

[esm_output]
  esm_history_vars = "smb artm thk usurf topg uvel vvel temp bmlt bwat beta_internal floating_mask grounded_mask bpmp acab_applied bmlt_applied calving_rate iareaf iareag imass imass_above_flotation total_smb_flux total_bmb_flux total_calving_flux total_gl_flux ice_sheet_mask ice_cap_mask"
  history_frequency = 1
  history_option = "nyears"

[options]
  adjust_input_thickness = .false.
  apply_calving_mask = .false.
  artm_anomaly_timescale = 0.0
  artm_anomaly_tstart = 0.0
  artm_input_function = 0
  basal_mass_balance = 1
  bmlt_float = 0
  bmlt_float_ismip6_magnitude = 1
  bmlt_float_thermal_forcing_param = 0
  calving_domain = 1
  calving_init = 1
  degree_factor = 1000.0
  dm_dt_diag = 1
  dycore = 2
  enable_acab_dthck_dt_correction = .false.
  enable_artm_anomaly = .false.
  enable_bmlt_anomaly = .false.
  enable_glaciers = .false.
  enable_precip_anomaly = .false.
  enable_smb_anomaly = .false.
  enable_snow_anomaly = .false.
  enable_thermal_forcing_anomaly = .false.
  evolution = 3
  flow_law = 2
  force_retreat = 0
  gthf = 1
  isostasy = 0
  limit_marine_cliffs = .false.
  marine_margin = 1
  ocean_data_domain = 0
  ocean_data_extrapolate = 0
  read_lat_lon = .false.
  remove_icebergs = .true.
  remove_isthmuses = .false.
  restart = 1
  sigma = 0
  smb_anomaly_timescale = 0.0
  smb_anomaly_tstart = 0.0
  smb_factor = 1.0
  smb_input = 0
  smb_input_function = 0
  snow_threshold_min = 0.0
  temp_init = 3
  temperature = 1
  vertical_integration = 0

[time]
  adaptive_cfl_threshold = 0.5
  dt = 0.1
  dt_diag = 0.1
  dt_input_option = 1
  idiag = 136
  jdiag = 294
  ndiag = 1
  nsteps_per_year = 10
  tend = 10000.0
  tstart = 0.0

[parameters]
  basal_tract_const = 1.e-4
  beta_grounded_min = 100.
  beta_powerlaw_umax = 5000.
  bmlt_cavity_h0 = 0.
  bmlt_float_depth_frzmax = 0.
  bmlt_float_depth_meltmax = 10.
  bmlt_float_depth_meltmin = 0.
  bmlt_float_depth_zfrzmax = -100.
  bmlt_float_depth_zmelt0 = -200.
  bmlt_float_depth_zmeltmax = -500.
  bmlt_float_depth_zmeltmin = 0.
  bmlt_float_h0 = 75.
  calving_minthck = 100.
  calving_timescale = 0.
  cliff_timescale = 0.0
  coulomb_c_bed_hi = 0.
  coulomb_c_bed_lo = -500.
  coulomb_c_const = 0.42
  coulomb_c_const_hi = 0.5
  coulomb_c_const_lo = 0.1
  coulomb_c_max = 1.0
  coulomb_c_min = 0.001
  deltaT_basin_relax = 0.0
  effstrain_min = 1.0e-8
  eigenconstant = 5.e5
  flow_factor_float = 1.
  flow_factor_ground = 1.
  gamma0 = 0.
  geothermal = 0.
  grav = 9.80616
  ice_limit = 1.
  inversion_babc_length_scale = 0.0
  inversion_babc_relax_factor = 0.05
  inversion_babc_thck_scale = 100.
  inversion_babc_timescale = 500.0
  inversion_bmlt_basin_flotation_threshold = 500.0
  inversion_bmlt_basin_mass_correction = 1000.0
  inversion_bmlt_basin_number_mass_correction = 9
  inversion_deltaT_ocn_length_scale = 0.0
  inversion_deltaT_ocn_temp_scale = 2.0
  inversion_deltaT_ocn_thck_scale = 100.
  inversion_deltaT_ocn_timescale = 100.
  inversion_thck_flotation_buffer = 2.
  inversion_thck_threshold = 1.
  lhci = 3.337e5
  log_level = 6
  marine_limit = -200
  max_slope = 0.5
  n_glen = 3.0
  p_ocean_penetration = 0.5
  pmp_offset = 10.
  powerlaw_c_const = 20000.
  powerlaw_c_max = 100000.
  powerlaw_c_min = 100.
  powerlaw_m = 3.0
  pseudo_plastic_q = 0.25
  pseudo_plastic_u0 = 100.
  rhoi = 917.
  rhoo = 1026.
  shci = 2117.27
  stress_threshold = 7.5e4
  t_lapse = 0.006
  tau_eigenconstant1 = 0.3
  tau_eigenconstant2 = 1.
  taumax_cliff = 1.e6
  thck_gradient_ramp = 100.
  thermal_forcing_basin_min = 0.0
  trpt = 273.16
  zoet_iverson_nmax = 1.e8
  zoet_iverson_ut = 200.

[ho_options]
  block_inception = .false.
  compute_blocks = 0
  diva_slope_correction = .true.
  elevation_based_coulomb_c = .false.
  glissade_maxiter = 100
  linear_solve_ncheck = 10
  remove_ice_caps = .false.
  reproducible_sums = .true.
  which_ho_approx = 4
  which_ho_assemble_beta = 1
  which_ho_assemble_bfric = 1
  which_ho_assemble_lateral = 1
  which_ho_assemble_taud = 1
  which_ho_babc = 9
  which_ho_beta_limit = 0
  which_ho_bwat = 0
  which_ho_calving_front = 0
  which_ho_coulomb_c = 0
  which_ho_deltaT_ocn = 0
  which_ho_disp = 1
  which_ho_effecpress = 0
  which_ho_efvs = 2
  which_ho_flotation_function = 2
  which_ho_gradient = 0
  which_ho_gradient_margin = 1
  which_ho_ground = 2
  which_ho_ground_bmlt = 1
  which_ho_nonlinear = 1
  which_ho_powerlaw_c = 2
  which_ho_precond = 1
  which_ho_resid = 4
  which_ho_sparse = 3
  which_ho_thermal_timestep = 0

[grid_ocn]
  dzocn = 0.0
  nbasin = 0
  nzocn = 1

